public class Room {
	int length;
	int width;
	int height;
	
	int calculateFloorArea(){
		int floorArea;
		floorArea = length * width;
		return floorArea;
	}
	
	int calculatePaintingCost(int rate){
		int wallArea = 2 * height * (width + length);
		int costOfPainting = wallArea * rate;
		return costOfPainting;
	}
}
