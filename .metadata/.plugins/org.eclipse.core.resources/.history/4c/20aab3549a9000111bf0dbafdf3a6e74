public class Room {
	private int length;
	private int width;
	private int height;
	private String color;
	private String nameBoard;
	  
	public void setColor(String color) {
		this.color = color;
	}
	
	public String getColor() {
		return this.color;
	}
	public Room(int length, int width, int height) {
		this.length = length;
		this.width = width;
		this.height = height;
	}
	
	public Room(int length, int width, int height, String color) {
		this(length, width, height); // constructor chaining
//		this.length = length;
//		this.width = width;
//		this.height = height;
		this.color = color;
	}
	
	int calculateFloorArea(){
		int floorArea;
		floorArea = length * width;
		return floorArea;
	}
	
	int calculatePaintingCost(int rate){
		int wallArea = 2 * height * (width + length);
		int costOfPainting = wallArea * rate;
		return costOfPainting;
	}
}
